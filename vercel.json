{
  "installCommand": "npm --prefix index ci",
  "buildCommand": "npm --prefix index run build",
  "outputDirectory": "index/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noimageindex" }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|gif|webp|svg|ico|avif)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, noimageindex" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
