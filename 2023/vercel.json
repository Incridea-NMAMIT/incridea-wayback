{
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:archive",
  "outputDirectory": ".next",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "connect-src 'self' https://unpkg.com" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    }
  ]
}
